<?xml version="1.0"?>

<robot name="pool" xmlns:xacro="http://www.ros.org/wiki/xacro" >
  <xacro:arg name="debug" default="0"/>
  <xacro:arg name="namespace" default="pool"/>
  <xacro:include filename="$(find pool_description)/urdf/pool.urdf.xacro"/>
  <xacro:pool namespace="$(arg namespace)" debug="$(arg debug)"/>
</robot>
