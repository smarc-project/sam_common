<?xml version="2.0"?>
<robot name="pool" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.141592" />
  <xacro:property name="body" value="file://$(find pool_description)/mesh/pool.dae"/>
  
  <xacro:macro name="pool" params="namespace debug">

  <!-- Links. -->
  <link name="$(arg namespace)/base_link">
    <visual>
      <!-- <origin xyz="0. 0 0." rpy="${-pi/2} ${-pi/2} 0"/> -->
      <!-- <origin xyz="0. 0 0." rpy="0 0 0"/> -->
      <origin xyz="0. 0 -0.2" rpy="0 0 ${-pi/2}"/>
      <geometry>
        <mesh filename="${body}" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  </xacro:macro>

</robot>
